{
  "name": "gw-ai-overhaul",
  "private": true,
  "scripts": {
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules\" \"!scripts/i18n/out\"",
    "format:md": "prettier --write \"**/*.md\" && markdownlint-cli2 --fix \"**/*.md\" \"!node_modules\" \"!scripts/i18n/out\"",
    "lint:css": "stylelint \"**/*.css\"",
    "format:css": "prettier --write \"**/*.css\" && stylelint --fix \"**/*.css\"",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "validate:json": "node scripts/validate/json-valid.js",
    "validate:manifest": "node scripts/validate/manifest.js",
    "validate:cards": "node scripts/validate/cards-contract.js",
    "validate:ai-mods": "node scripts/validate/ai-mods-contract.js",
    "validate:schemas": "node scripts/validate/schemas.js",
    "validate:refs": "node scripts/validate/cross-refs.js",
    "validate:sonar": "node scripts/validate/sonar-config.js",
    "validate:docs": "node scripts/validate/docs-inventory.js",
    "validate:translations": "node scripts/validate/translations.js",
    "validate": "npm run validate:json && npm run validate:manifest && npm run validate:cards && npm run validate:ai-mods && npm run validate:schemas && npm run validate:refs && npm run validate:sonar && npm run validate:docs && npm run validate:translations",
    "validate:race-trees": "node scripts/validate-race-trees.js",
    "i18n:extract": "node scripts/i18n/extract.js",
    "i18n:catalog": "node scripts/i18n/catalog.js",
    "i18n:missing": "node scripts/i18n/missing.js",
    "i18n:glossary": "node scripts/i18n/glossary.js",
    "i18n:merge": "node scripts/i18n/merge.js",
    "test": "node --test",
    "pretest:coverage": "node -e \"require('fs').mkdirSync('coverage', { recursive: true })\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"ui/**/*.js\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "verify": "npm run lint:js && npm run lint:css && npm run lint:md && npm run format:check && npm run validate && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-es-x": "^10.0.0",
    "globals": "^17.12.0",
    "lodash": "3.9.3",
    "markdownlint-cli2": "^0.23.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1"
  }
}
